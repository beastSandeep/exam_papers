//- Right Column Paper Overview & Settings Component
div(class="space-y-5")
  // Paper Overview & Section Navigator
  div(class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200")
    div(class="flex items-center justify-between pb-3 border-b border-slate-100")
      h3(class="font-bold text-slate-800 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-1.5")
        svg(class="w-4 h-4 text-indigo-600 shrink-0", fill="none", stroke="currentColor", viewBox="0 0 24 24")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4")
        span Paper Overview
      span(
        class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border uppercase tracking-wider bg-indigo-50 text-indigo-700 border-indigo-200 shrink-0",
        x-text="selectedQuestionIds.length + ' Qs Selected'"
      )

    // Dynamic Marks Summary Meter
    div(class="mt-3.5 p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between")
      div
        span(class="text-[10px] font-bold uppercase text-slate-600 block") Total Calculated Marks
        div(class="flex items-baseline gap-1 mt-0.5")
          span(class="text-xl sm:text-2xl font-black text-indigo-700", x-text="calculateTotalMarks()")
          span(class="text-xs font-semibold text-slate-600", x-text="'/ ' + (customMeta.maxMarks || currentBlueprint.maxMarks || 50) + ' M'")
      div(class="text-right")
        span(class="text-[10px] font-bold uppercase text-slate-600 block") Paper Status
        span(
          :class="isPaperComplete() ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-amber-100 text-amber-800 border-amber-300'",
          class="inline-block text-[10px] font-extrabold px-2 py-0.5 rounded-full border mt-0.5 uppercase tracking-wide",
          x-text="isPaperComplete() ? 'Ready for Print' : 'In Progress'"
        )

    // Segmented Navigation Tabs: Checklist vs Chosen Questions
    div(class="mt-3.5 grid grid-cols-2 gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-semibold")
      button(
        type="button",
        @click="paperOverviewTab = 'checklist'",
        :class="paperOverviewTab === 'checklist' ? 'bg-white text-indigo-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'",
        class="py-1.5 px-2 rounded-lg transition flex items-center justify-center gap-1.5"
      )
        span 📋
        span Checklist
      
      button(
        type="button",
        @click="paperOverviewTab = 'chosen'",
        :class="paperOverviewTab === 'chosen' ? 'bg-white text-indigo-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'",
        class="py-1.5 px-2 rounded-lg transition flex items-center justify-center gap-1.5"
      )
        span 📝
        span Chosen Qs
        span(
          :class="paperOverviewTab === 'chosen' ? 'bg-indigo-100 text-indigo-800' : 'bg-slate-200 text-slate-700'",
          class="text-[10px] px-1.5 py-0.2 rounded-full font-bold ml-0.5",
          x-text="selectedQuestionIds.length"
        )

    // TAB 1: Section Checklist
    div(x-show="paperOverviewTab === 'checklist'", class="mt-3.5 space-y-2.5")
      div(class="flex items-center justify-between")
        h4(class="text-[11px] font-bold text-slate-600 uppercase tracking-wider") Section Checklist
        span(class="text-[10px] text-slate-400 font-medium") Click section to filter
      div(class="space-y-2 max-h-[320px] overflow-y-auto pr-1")
        template(x-for="(sec, idx) in currentBlueprint.sections", :key="sec.key")
          div(
            @click="selectSection(sec.key)",
            :class="activeSectionKey === sec.key ? 'bg-indigo-50/70 border-indigo-200 ring-1 ring-indigo-200' : 'bg-slate-50/70 border-slate-200/80 hover:bg-slate-100/70'",
            class="p-2.5 rounded-xl border transition cursor-pointer flex flex-col gap-1.5"
          )
            div(class="flex items-center justify-between")
              div(class="flex items-center space-x-1.5 truncate")
                span(class="text-xs font-bold text-slate-800 shrink-0", x-text="'Sec ' + (idx + 1) + ':'")
                span(class="text-xs text-slate-600 truncate font-medium", x-text="sec.subTitle ? sec.subTitle.split(' / ')[0] : sec.title.replace('### ', '')")
              span(
                :class="getSectionPillClass(sec.key)",
                class="text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0",
                x-text="getSectionSelectedCount(sec.key) + ' Qs'"
              )
            div(class="flex items-center justify-between text-[11px] text-slate-500 pt-0.5 border-t border-slate-200/40")
              span(x-text="'Section Total: ' + getSectionTotalMarks(sec.key) + ' Marks'")
              span(class="font-mono text-[10px]", x-text="'Def: ' + sec.marksEach + 'M each'")

    // TAB 2: Chosen Questions List with Edit Capability
    div(x-show="paperOverviewTab === 'chosen'", class="mt-3.5 space-y-2.5")
      div(class="flex items-center justify-between")
        h4(class="text-[11px] font-bold text-slate-600 uppercase tracking-wider flex items-center gap-1")
          span 📝
          span Chosen Questions in Paper
        span(class="text-[10px] text-slate-400 font-medium") Edit or re-mark questions

      // Empty State
      template(x-if="selectedQuestionIds.length === 0")
        div(class="p-6 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 space-y-2")
          span(class="text-2xl block") 📭
          p(class="text-xs font-bold text-slate-700") No questions selected yet
          p(class="text-[11px] text-slate-500") Pick questions from the Question Bank on the left or use Quick Pick.
          button(
            type="button",
            @click="autoFillSet('Set A')",
            class="text-xs font-bold text-indigo-600 hover:underline pt-1"
          ) Quick Pick Set A Questions →

      // Populated Chosen Questions (Grouped by Section)
      template(x-if="selectedQuestionIds.length > 0")
        div(class="space-y-3 max-h-[350px] overflow-y-auto pr-1")
          template(x-for="grp in getChosenQuestionsGroupedBySection()", :key="grp.section.key")
            div(class="space-y-1.5")
              // Section Sub-header
              div(class="flex items-center justify-between px-1 text-[11px] font-bold text-slate-600 uppercase tracking-wider bg-slate-100/80 py-1 rounded-md")
                span(class="truncate", x-text="grp.section.title.replace('### ', '') + ' (' + grp.questions.length + ' Qs)'")
                span(class="text-indigo-700 font-extrabold shrink-0", x-text="getSectionTotalMarks(grp.section.key) + ' M'")
              
              // Individual Chosen Questions
              div(class="space-y-2")
                template(x-for="(q, qIdx) in grp.questions", :key="q.id")
                  div(class="bg-slate-50/90 hover:bg-slate-100 rounded-xl p-2.5 border border-slate-200/90 transition space-y-1.5")
                    // Card Header: Question index, chapter, OR tag, inline marks
                    div(class="flex items-center justify-between gap-1.5")
                      div(class="flex items-center gap-1.5 truncate")
                        span(class="font-black text-xs text-slate-800 shrink-0", x-text="'Q' + (qIdx + 1)")
                        span(class="text-[10px] font-semibold px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 truncate max-w-[130px]", x-text="q.chapter || 'Ch'")
                        template(x-if="isQuestionPairedAsPrimary(q.id)")
                          span(class="text-[9px] font-bold px-1 py-0.2 rounded bg-amber-100 text-amber-800 border border-amber-300 shrink-0") 🔀 OR Pair
                      
                      // Inline Marks Editor
                      div(class="flex items-center gap-1 shrink-0")
                        input(
                          type="number",
                          min="0.5",
                          max="20",
                          step="0.5",
                          :value="getQuestionMarks(q.id)",
                          @input="setQuestionMarksInline(q.id, $event.target.value)",
                          title="Click to edit marks for this question",
                          class="w-12 text-center text-[11px] font-black text-indigo-700 bg-white border border-slate-300 rounded py-0.5 px-1 focus:ring-1 focus:ring-indigo-500 shadow-2xs"
                        )
                        span(class="text-[10px] font-bold text-slate-400") M

                    // Bilingual Preview snippet
                    p(class="text-xs text-slate-700 line-clamp-2 leading-snug font-medium", x-text="getQuestionCleanTitle(q)")

                    // Action Buttons Bar
                    div(class="flex items-center justify-between pt-1 border-t border-slate-200/60")
                      button(
                        type="button",
                        @click="openEditQuestionModal(q)",
                        title="Edit question text, Hindi/English translation, options or marks",
                        class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-2 py-0.5 rounded transition flex items-center gap-1"
                      )
                        span ✎ Edit Question
                      
                      div(class="flex items-center gap-1")
                        button(
                          type="button",
                          @click="openPairingModal(q.id)",
                          title="Pair this question with an alternative OR question",
                          class="text-[10px] font-semibold text-slate-600 hover:text-indigo-600 hover:bg-slate-200/60 px-1.5 py-0.5 rounded transition"
                        ) 🔀 Pair OR
                        
                        button(
                          type="button",
                          @click="toggleQuestion(q.id)",
                          title="Remove this question from paper",
                          class="text-[10px] font-semibold text-rose-600 hover:text-rose-800 hover:bg-rose-50 px-1.5 py-0.5 rounded transition"
                        ) ✕ Remove

  // Custom Paper Settings (Quick Access & Studio Link)
  div(class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 space-y-3.5")
    div(class="flex items-center justify-between pb-2 border-b border-slate-100")
      h3(class="font-bold text-slate-800 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-1.5")
        svg(class="w-4 h-4 text-slate-600", fill="none", stroke="currentColor", viewBox="0 0 24 24")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
        span Paper Settings (पेपर विवरण)
      
      button(
        type="button",
        @click="openPaperSettingsModal()",
        class="text-[11px] text-indigo-600 hover:text-indigo-800 hover:underline font-bold flex items-center gap-1"
      )
        span ⚙️ Full Studio

    div(class="space-y-2.5")
      // School Name
      div
        label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1") School Name (विद्यालय का नाम):
        input(
          type="text",
          x-model="customMeta.schoolName",
          @input="persistState()",
          placeholder="Enter School / College Name (e.g. Cambridge School)...",
          class="w-full text-xs font-semibold rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50/50"
        )

      // Exam Type Selector
      div
        label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1") Exam Type (परीक्षा प्रकार):
        select(
          x-model="customMeta.examType",
          @change="onExamTypeChange()",
          class="w-full text-xs font-semibold rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50/50"
        )
          option(value="HALF YEARLY EXAMINATION") Half Yearly Examination (अर्धवार्षिक परीक्षा)
          option(value="ANNUAL EXAMINATION") Annual Examination (वार्षिक परीक्षा)
          option(value="UNIT TEST – 1") Unit Test 1 (इकाई परीक्षा 1)
          option(value="UNIT TEST – 2") Unit Test 2 (इकाई परीक्षा 2)
          option(value="UNIT TEST – 3") Unit Test 3 (इकाई परीक्षा 3)
          option(value="PERIODIC TEST – 1") Periodic Test 1 (आवधिक परीक्षा 1)
          option(value="PERIODIC TEST – 2") Periodic Test 2 (आवधिक परीक्षा 2)
          option(value="PERIODIC TEST – 3") Periodic Test 3 (आवधिक परीक्षा 3)
          option(value="PRE-BOARD EXAMINATION") Pre-Board Examination (प्री-बोर्ड परीक्षा)
          option(value="CUSTOM") ➕ Custom Exam Title...
        
        div(x-show="customMeta.examType === 'CUSTOM'", class="pt-1.5")
          input(
            type="text",
            x-model="customMeta.examTitle",
            @input="persistState()",
            placeholder="e.g. FIRST TERM EXAM: 2026 – 27",
            class="w-full text-xs font-semibold rounded-lg border-indigo-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
          )

      // Session Year Quick Switcher
      div
        div(class="flex items-center justify-between mb-1")
          label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider") Session Year (सत्र):
          span(class="text-[10px] text-emerald-600 font-bold") 2026 – 27
        div(class="grid grid-cols-3 gap-1")
          template(x-for="yr in ['2026 – 27', '2025 – 26', '2027 – 28']", :key="yr")
            button(
              type="button",
              @click="setSessionYear(yr)",
              :class="customMeta.sessionYear === yr ? 'bg-indigo-600 text-white font-bold shadow-xs' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'",
              class="py-1 text-xs rounded-lg transition"
              x-text="yr"
            )

      // Target Marks & Set Code
      div(class="grid grid-cols-2 gap-2 pt-0.5")
        div
          div(class="flex items-center justify-between mb-1")
            label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider") Max Marks:
            button(
              type="button",
              @click="syncMaxMarksToCalculated()",
              title="Match max marks to selected questions total",
              class="text-[9px] text-indigo-600 hover:underline font-bold"
            ) 🎯 Sync
          input(
            type="number",
            min="1",
            max="200",
            x-model.number="customMeta.maxMarks",
            @input="persistState()",
            :placeholder="currentBlueprint.maxMarks || 50",
            class="w-full text-xs font-bold text-indigo-700 rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50/50"
          )
        div
          label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1") Set Code:
          input(
            type="text",
            x-model="customMeta.setName",
            @input="persistState()",
            placeholder="e.g. SET – A",
            class="w-full text-xs font-semibold rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50/50"
          )

      // Time Allowed
      div
        label(class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1") Time Duration (समय सीमा):
        input(
          type="text",
          x-model="customMeta.time",
          @input="persistState()",
          placeholder="e.g. 2½ HOURS or 1 HOUR",
          class="w-full text-xs font-semibold rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50/50"
        )
      
      // General Instructions Toggle
      div(class="pt-1")
        label(class="flex items-center justify-between cursor-pointer")
          span(class="text-xs font-semibold text-slate-700") Include General Instructions
          div(class="relative inline-flex items-center")
            input(
              type="checkbox",
              x-model="customMeta.includeInstructions",
              @change="persistState()",
              class="sr-only peer"
            )
            div(class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600")

      // Button to open Full Modal with Presets & Live Header Preview
      button(
        type="button",
        @click="openPaperSettingsModal()",
        class="w-full mt-2 py-2 px-3 rounded-xl font-bold text-xs bg-slate-900 hover:bg-slate-800 text-white shadow-xs transition flex items-center justify-center gap-1.5"
      )
        span ⚡
        span Header Studio & 1-Click Presets (UT, Annual...)

  // Paper Actions
  div(class="space-y-2 pt-1")
    button(
      type="button",
      @click="openPreview()",
      class="w-full py-2.5 px-4 rounded-xl font-bold text-xs sm:text-sm bg-emerald-600 hover:bg-emerald-500 text-white shadow-md transition flex items-center justify-center space-x-2"
    )
      svg(class="w-4 h-4", fill="none", stroke="currentColor", viewBox="0 0 24 24")
        path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
        path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
      span Preview & Export Paper

    div(class="grid grid-cols-2 gap-2")
      button(
        type="button",
        @click="saveCurrentPaper()",
        class="py-2 px-3 rounded-xl font-semibold text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition flex items-center justify-center space-x-1"
      )
        svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4")
        span Save Paper
      
      button(
        type="button",
        @click="printDirect()",
        class="py-2 px-3 rounded-xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-white transition flex items-center justify-center space-x-1"
      )
        svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
        span Print Direct

    button(
      type="button",
      @click="clearAllSelections()",
      class="w-full py-1.5 text-center text-xs text-rose-600 hover:text-rose-800 hover:underline font-medium"
    ) Reset & Clear All Selected Questions
