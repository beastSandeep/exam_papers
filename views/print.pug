doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title || 'Exam Paper Printout'}

    // Fonts
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap", rel="stylesheet")

    // Tailwind
    script(src="https://cdn.tailwindcss.com?plugins=typography")

    // KaTeX CSS & JS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css")
    script(defer, src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js")
    script(defer, src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js")

    // Marked.js
    script(src="https://cdn.jsdelivr.net/npm/marked/marked.min.js")

    link(rel="stylesheet", href="/css/style.css")

    style.
      body {
        font-family: 'Merriweather', serif;
        background: #f1f5f9;
      }
      @media print {
        body {
          background: #ffffff !important;
        }
        .no-print {
          display: none !important;
        }
      }

  body(class="min-h-screen p-3 sm:p-6", class=(customMeta && customMeta.printLayoutMode === 'compact' ? 'mode-compact' : ''))
    // Action bar (Hidden when printing)
    div(class="no-print max-w-4xl mx-auto mb-5 flex flex-wrap items-center justify-between gap-3 bg-white p-3.5 sm:p-4 rounded-xl shadow-sm border border-slate-200")
      div
        h2(class="text-base font-bold text-slate-800 font-sans flex items-center gap-2")
          span 🖨️ Print & PDF Export Studio
          span(id="layout-indicator", class="text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200") Paper Saver Mode
        p(class="text-xs text-slate-500 font-sans mt-0.5") Select layout density below, then click Print to save as PDF.

      div(class="flex items-center flex-wrap gap-2")
        // Layout Mode Switcher
        div(class="flex items-center bg-slate-100 p-1 rounded-lg border border-slate-200")
          button(
            id="btn-mode-standard",
            onclick="setLayoutMode('standard')",
            class="px-2.5 py-1 text-xs font-semibold rounded transition font-sans text-slate-600 hover:text-slate-900"
          ) 📄 Standard
          button(
            id="btn-mode-compact",
            onclick="setLayoutMode('compact')",
            class="px-2.5 py-1 text-xs font-semibold rounded transition font-sans bg-emerald-600 text-white shadow-xs"
          ) 🌿 Paper Saver
          button(
            id="btn-mode-twocolumn",
            onclick="setLayoutMode('twocolumn')",
            class="px-2.5 py-1 text-xs font-semibold rounded transition font-sans text-slate-600 hover:text-slate-900"
          ) 📰 2-Column

        button(onclick="window.close()", class="px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition font-sans") Close
        button(onclick="window.print()", class="px-4 py-1.5 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition flex items-center gap-1.5 font-sans")
          svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
          span Print / Save PDF

    // Printable Paper Container
    main(
      id="paper-container",
      class="exam-sheet max-w-4xl mx-auto bg-white p-6 sm:p-10 rounded-xl shadow-lg border border-slate-200 transition-all"
    )
      div(id="paper-content", class="prose max-w-none text-slate-800")
        // Rendered via JS below

    script.
      const rawMarkdown = !{JSON.stringify(markdown)};
      const initialCustomMeta = !{JSON.stringify(customMeta || {})};
      let currentLayout = initialCustomMeta.printLayoutMode || 'compact';

      function setLayoutMode(mode) {
        currentLayout = mode;
        const container = document.getElementById('paper-container');
        const indicator = document.getElementById('layout-indicator');
        const btnStandard = document.getElementById('btn-mode-standard');
        const btnCompact = document.getElementById('btn-mode-compact');
        const btnTwoCol = document.getElementById('btn-mode-twocolumn');

        // Reset classes
        container.classList.remove('paper-saver', 'two-column-print');
        document.body.classList.remove('mode-compact');
        [btnStandard, btnCompact, btnTwoCol].forEach(b => {
          b.className = 'px-2.5 py-1 text-xs font-semibold rounded transition font-sans text-slate-600 hover:text-slate-900';
        });

        if (mode === 'compact') {
          container.classList.add('paper-saver');
          document.body.classList.add('mode-compact');
          btnCompact.className = 'px-2.5 py-1 text-xs font-semibold rounded transition font-sans bg-emerald-600 text-white shadow-xs';
          indicator.textContent = '🌿 Paper Saver Mode (Ultra-Compact)';
          indicator.className = 'text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200';
        } else if (mode === 'twocolumn') {
          container.classList.add('paper-saver', 'two-column-print');
          document.body.classList.add('mode-compact');
          btnTwoCol.className = 'px-2.5 py-1 text-xs font-semibold rounded transition font-sans bg-amber-600 text-white shadow-xs';
          indicator.textContent = '📰 2-Column Economy Mode';
          indicator.className = 'text-[11px] font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200';
        } else {
          btnStandard.className = 'px-2.5 py-1 text-xs font-semibold rounded transition font-sans bg-indigo-600 text-white shadow-xs';
          indicator.textContent = '📄 Standard Spacing Mode';
          indicator.className = 'text-[11px] font-semibold px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 border border-indigo-200';
        }
      }

      window.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('paper-content');
        if (window.marked && rawMarkdown) {
          container.innerHTML = marked.parse(rawMarkdown);
          
          setTimeout(() => {
            if (window.renderMathInElement) {
              renderMathInElement(container, {
                delimiters: [
                  { left: '$$', right: '$$', display: true },
                  { left: '$', right: '$', display: false }
                ],
                throwOnError: false
              });
            }
          }, 50);
        }

        // Apply chosen layout mode
        setLayoutMode(currentLayout);
      });
