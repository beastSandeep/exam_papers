extends layout

block content
  div(x-data="paperApp()", x-init="init()", class="min-h-screen flex flex-col")
    
    // Top Navigation Bar
    header(class="no-print bg-slate-900 border-b border-slate-800 text-white sticky top-0 z-30 shadow-md")
      div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between")
        div(class="flex items-center space-x-3")
          div(class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-emerald-400 flex items-center justify-center shadow-inner")
            svg(class="w-6 h-6 text-white", fill="none", stroke="currentColor", viewBox="0 0 24 24")
              path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
          div
            h1(class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2")
              span Exam Paper Builder
              span(class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30") 3-Set Bank
            p(class="text-xs text-slate-400 hidden sm:block") New M.V.M. Sr. Sec. School &bull; Bilingual Half-Yearly Generator

        // Actions
        div(class="flex items-center space-x-2 sm:space-x-3")
          // Saved papers button
          button(@click="openSavedPapers()", class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition flex items-center gap-1.5 border border-slate-700")
            svg(class="w-4 h-4", fill="none", stroke="currentColor", viewBox="0 0 24 24")
              path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4")
            span Saved Papers
            span(x-show="savedPapersCount > 0", x-text="savedPapersCount", class="ml-1 px-1.5 py-0.2 bg-indigo-500 text-white text-[10px] rounded-full")

          // Quick Presets Dropdown
          div(class="relative", x-data="{ open: false }")
            button(@click="open = !open", class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg bg-indigo-950/70 hover:bg-indigo-900/80 text-indigo-200 border border-indigo-700/50 transition flex items-center gap-1.5")
              svg(class="w-4 h-4", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M13 10V3L4 14h7v7l9-11h-7z")
              span Auto-Fill Set
              svg(class="w-3.5 h-3.5 ml-0.5 opacity-70", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M19 9l-7 7-7-7")
            div(x-show="open", @click.away="open = false", x-cloak, class="absolute right-0 mt-2 w-48 bg-slate-800 rounded-xl shadow-xl py-1 z-50 border border-slate-700 text-xs")
              button(@click="autoFillSet('Set A'); open = false", class="w-full text-left px-4 py-2 hover:bg-slate-700/80 text-slate-200 flex items-center justify-between")
                span Load Set A (Original)
                span(class="w-2 h-2 rounded-full bg-emerald-400")
              button(@click="autoFillSet('Set B'); open = false", class="w-full text-left px-4 py-2 hover:bg-slate-700/80 text-slate-200 flex items-center justify-between")
                span Load Set B (Variation 2)
                span(class="w-2 h-2 rounded-full bg-sky-400")
              button(@click="autoFillSet('Set C'); open = false", class="w-full text-left px-4 py-2 hover:bg-slate-700/80 text-slate-200 flex items-center justify-between")
                span Load Set C (Variation 3)
                span(class="w-2 h-2 rounded-full bg-purple-400")
              button(@click="autoFillSet('Sample Paper'); open = false", class="w-full text-left px-4 py-2 hover:bg-slate-700/80 text-amber-200 flex items-center justify-between")
                span Load Sample / Drill Set
                span(class="w-2 h-2 rounded-full bg-amber-400")
              div(class="border-t border-slate-700 my-1")
              button(@click="randomizeSelection(); open = false", class="w-full text-left px-4 py-2 hover:bg-slate-700/80 text-amber-300")
                span 🎲 Mix & Match (Randomize)

          // Preview Paper Modal Trigger
          button(@click="openPreview()", class="px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm transition flex items-center gap-1.5")
            svg(class="w-4 h-4", fill="none", stroke="currentColor", viewBox="0 0 24 24")
              path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
              path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
            span Preview & Export

    // Main App Body
    main(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full")

      // 1. Subject Selector Cards
      div(class="mb-6")
        h2(class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2.5") Select Class & Subject
        div(class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 sm:gap-3")
          template(x-for="sub in subjectsList", :key="sub.id")
            button(
              @click="changeSubject(sub.id)",
              :class="selectedSubjectId === sub.id ? 'bg-indigo-600 text-white shadow-md ring-2 ring-indigo-600 ring-offset-2' : 'bg-white text-slate-700 hover:bg-slate-100/80 border border-slate-200'",
              class="p-3 rounded-xl text-left transition flex flex-col justify-between relative group"
            )
              div(class="flex items-center justify-between w-full mb-1")
                span(
                  :class="selectedSubjectId === sub.id ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600'",
                  class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md",
                  x-text="'CLASS ' + sub.class"
                )
                span(
                  :class="selectedSubjectId === sub.id ? 'text-indigo-200' : 'text-slate-400'",
                  class="text-[11px] font-medium",
                  x-text="sub.isScience ? '6 Secs' : '5 Secs'"
                )
              div(class="font-bold text-sm sm:text-base leading-tight mt-1", x-text="sub.name")
              div(
                :class="selectedSubjectId === sub.id ? 'text-indigo-100' : 'text-slate-500'",
                class="text-xs mt-1 font-medium flex items-center justify-between"
              )
                span(x-text="sub.maxMarks + ' Marks'")
                span(class="text-[10px] opacity-80", x-text="sub.time")

      // 2. Main Builder Grid (2 Columns: Left Question Bank, Right Constraints/Status)
      div(class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start")
        
        // Left Column: Section Tabs & Question Cards (8 cols on lg)
        div(class="lg:col-span-8 space-y-5")

          // Section Selector Tabs (Single-Question Type Mode)
          div(class="bg-white rounded-2xl p-2 shadow-sm border border-slate-200/80")
            div(class="flex flex-wrap items-center justify-between gap-2 px-2 pt-1 pb-2 border-b border-slate-100")
              div
                h3(class="text-xs font-bold text-slate-500 uppercase tracking-wider") Question Type / Section
                p(class="text-xs text-slate-400") Select questions one type at a time to complete each section
              div(class="flex flex-wrap items-center gap-2.5")
                // Chapter Filter Dropdown
                div(class="flex items-center space-x-1.5")
                  span(class="text-xs text-slate-500 font-semibold") Chapter:
                  select(x-model="chapterFilter", class="text-xs bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-slate-700 font-medium focus:ring-1 focus:ring-indigo-500 max-w-[170px] sm:max-w-[210px] truncate")
                    option(value="all") All Chapters (सभी अध्याय)
                    template(x-for="ch in getAvailableChapters()", :key="ch")
                      option(:value="ch", x-text="ch")

                // Set Filter Dropdown
                div(class="flex items-center space-x-1.5")
                  span(class="text-xs text-slate-500 font-semibold") Set:
                  select(x-model="variationFilter", class="text-xs bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-slate-700 font-medium focus:ring-1 focus:ring-indigo-500")
                    option(value="all") All Sets & Samples
                    option(value="Set A") Set A Only
                    option(value="Set B") Set B Only
                    option(value="Set C") Set C Only
                    option(value="Sample Paper") Sample / Drill

            // Tab Buttons
            div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-5 gap-1.5 mt-2")
              template(x-for="(sec, idx) in currentBlueprint.sections", :key="sec.key")
                button(
                  @click="activeSectionKey = sec.key",
                  :class="activeSectionKey === sec.key ? 'bg-indigo-50 text-indigo-700 border-indigo-300 font-semibold shadow-sm' : 'bg-slate-50/70 text-slate-600 hover:bg-slate-100 border-transparent'",
                  class="p-2.5 rounded-xl border text-left transition flex flex-col justify-between"
                )
                  div(class="flex items-center justify-between w-full mb-1")
                    span(class="text-xs font-bold uppercase", x-text="'SEC ' + (idx + 1)")
                    // Status Badge
                    span(
                      :class="getSectionBadgeClass(sec.key)",
                      class="text-[10px] font-bold px-1.5 py-0.5 rounded-md",
                      x-text="getSectionSelectedCount(sec.key) + ' Qs'"
                    )
                  div(class="text-xs truncate text-slate-700 font-medium", x-text="sec.subTitle || sec.title")
                  div(class="text-[10px] text-slate-400 mt-1 flex justify-between")
                    span(x-text="'Def: ' + sec.marksEach + 'M'")
                    span(class="font-semibold text-slate-600", x-text="getSectionTotalMarks(sec.key) + 'M'")

          // Active Section Header Banner
          div(class="bg-gradient-to-r from-slate-900 to-indigo-950 text-white p-4 rounded-2xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3")
            div
              div(class="flex items-center gap-2")
                span(class="px-2 py-0.5 rounded bg-indigo-500/30 text-indigo-200 text-xs font-semibold uppercase tracking-wider", x-text="'Section ' + activeSectionKey.toUpperCase()")
                span(class="text-xs text-slate-300", x-text="'Default: ' + getActiveSection().marksEach + ' Mark(s) • Custom marks allowed'")
              h2(class="text-base sm:text-lg font-bold mt-1 text-white", x-text="getActiveSection().subTitle || getActiveSection().title")
              p(class="text-xs text-slate-300 mt-0.5", x-text="getSectionSelectedCount(activeSectionKey) + ' question(s) chosen in this section (' + getSectionTotalMarks(activeSectionKey) + ' Marks total). Pick any number of questions and customize marks.'")
            
            // Counter & Quick Section Selection
            div(class="flex items-center gap-3 bg-white/10 px-3.5 py-2 rounded-xl border border-white/10")
              div(class="text-right")
                div(class="text-[10px] uppercase font-bold text-slate-300") Section Total
                div(class="text-base font-extrabold flex items-center justify-end gap-1 text-emerald-400")
                  span(x-text="getSectionSelectedCount(activeSectionKey) + ' Qs'")
                  span(class="text-slate-300 text-xs ml-0.5 font-normal", x-text="'(' + getSectionTotalMarks(activeSectionKey) + ' M)'")
              
              // Quick Section Picker & Tools
              div(class="border-l border-white/20 pl-3 flex flex-col gap-1")
                button(@click="quickPickSection(activeSectionKey, 'Set A')", class="text-[10px] text-emerald-300 hover:text-emerald-200 underline font-medium") + All from Set A
                button(@click="quickPickSection(activeSectionKey, 'Set B')", class="text-[10px] text-sky-300 hover:text-sky-200 underline font-medium") + All from Set B
                button(@click="promptSetSectionMarks(activeSectionKey)", class="text-[10px] text-amber-300 hover:text-amber-200 underline font-medium") ✎ Set marks for all in Sec

          // Questions List for Active Section
          div(class="space-y-3")
            div(class="flex items-center justify-between text-xs text-slate-500 px-1")
              span(x-text="'Showing ' + getFilteredQuestionsForActiveSection().length + ' available questions in question bank'")
              div(class="flex items-center gap-2")
                button(@click="clearActiveSection()", class="text-rose-600 hover:underline text-xs") Clear Section Picks

            template(x-for="q in getFilteredQuestionsForActiveSection()", :key="q.id")
              div(
                @click="toggleQuestion(q.id, q.sectionKey)",
                :class="isQuestionSelected(q.id) ? 'border-indigo-500 bg-indigo-50/50 shadow-md ring-1 ring-indigo-400' : 'border-slate-200 bg-white hover:border-indigo-300 hover:shadow-sm'",
                class="p-4 sm:p-5 rounded-2xl border transition-all cursor-pointer relative group"
              )
                // Top Meta row
                div(class="flex items-start justify-between gap-3 mb-2.5")
                  div(class="flex items-center space-x-2 flex-wrap gap-y-1")
                    // Checkbox
                    input(
                      type="checkbox",
                      :checked="isQuestionSelected(q.id)",
                      @click.stop="toggleQuestion(q.id, q.sectionKey)",
                      class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 cursor-pointer"
                    )
                    // Set Pill
                    span(
                      :class="getSetBadgeClass(q.set)",
                      class="text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider",
                      x-text="q.set"
                    )
                    // Editable Marks Field
                    div(
                      @click.stop,
                      class="flex items-center gap-1 px-2 py-0.5 rounded-full border text-[10px] transition font-medium",
                      :class="customMarks[q.id] !== undefined ? 'bg-amber-50 border-amber-300 text-amber-900 ring-1 ring-amber-200' : 'bg-slate-100 border-slate-200 text-slate-700'"
                    )
                      span(class="text-[10px] text-slate-500 font-semibold") Marks:
                      input(
                        type="number",
                        min="0.5",
                        max="50",
                        step="0.5",
                        :value="getQuestionMarks(q.id)",
                        @input="setQuestionMarks(q.id, $event.target.value)",
                        title="Edit question marks (Click to customize)",
                        class="w-11 h-5 text-center font-bold text-xs bg-white border rounded px-0.5 py-0 focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500",
                        :class="customMarks[q.id] !== undefined ? 'border-amber-400 text-amber-950 font-black' : 'border-slate-300 text-slate-800'"
                      )
                      template(x-if="customMarks[q.id] !== undefined")
                        button(
                          @click.stop="resetQuestionMarks(q.id)",
                          :title="'Reset to default (' + q.marks + ' M)'",
                          class="text-rose-500 hover:text-rose-700 font-extrabold text-[11px] ml-0.5"
                        ) ✕
                    // Chapter Pill
                    span(x-show="q.chapter", class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200/80 flex items-center gap-1 max-w-[260px] truncate")
                      svg(class="w-3 h-3 text-indigo-500 shrink-0", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                        path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253")
                      span(class="truncate", x-text="q.chapter")
                    // Active OR Partner Badges
                    template(x-if="orPairs[q.id]")
                      span(class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 flex items-center gap-1.5")
                        span 🔀 OR:
                        span(class="truncate max-w-[130px]", x-text="getQuestionPreview(orPairs[q.id])")
                        button(@click.stop="removeOrPair(q.id)", title="Remove OR pairing", class="text-rose-600 hover:text-rose-800 font-extrabold ml-0.5") ✕
                    template(x-if="isQuestionPairedAsAlternative(q.id)")
                      span(class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 border border-purple-200 flex items-center gap-1")
                        span 🔗 Alternative OR Choice
                        button(@click.stop="unlinkAsAlternative(q.id)", title="Unlink OR choice", class="text-rose-600 hover:text-rose-800 font-extrabold ml-0.5") ✕

                  // Actions: Pair OR & Select/Deselect
                  div(class="flex items-center space-x-1.5 shrink-0")
                    button(
                      x-show="isQuestionSelected(q.id) && !isQuestionPairedAsAlternative(q.id)",
                      @click.stop="openPairingModal(q.id)",
                      :class="orPairs[q.id] ? 'bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-amber-50 hover:text-amber-800 hover:border-amber-300'",
                      class="text-xs font-semibold px-2 py-1 rounded-lg border transition flex items-center gap-1"
                    )
                      svg(class="w-3.5 h-3.5 text-amber-600", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                        path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4")
                      span(x-text="orPairs[q.id] ? 'Change OR' : '+ Pair OR'")

                    button(
                      @click.stop="toggleQuestion(q.id, q.sectionKey)",
                      :class="isQuestionSelected(q.id) ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600'",
                      class="text-xs font-semibold px-2.5 py-1 rounded-lg transition shrink-0"
                    )
                      span(x-text="isQuestionSelected(q.id) ? '✓ Selected' : '+ Select'")

                // Question Content Display (Bilingual)
                div(class="text-slate-800 text-sm sm:text-base leading-relaxed pl-6")
                  div(class="question-render font-serif whitespace-pre-line", x-html="renderQuestionContent(q.content)")

        // Right Column: Live Paper Constraints Meter & Control Panel (4 cols on lg)
        div(class="lg:col-span-4 space-y-5 lg:sticky lg:top-20")

          // Paper Overview & Section Navigator
          div(class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200")
            div(class="flex items-center justify-between pb-3 border-b border-slate-100")
              h3(class="font-bold text-slate-800 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-1.5")
                svg(class="w-4 h-4 text-indigo-600 shrink-0", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                  path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4")
                span Paper Overview
              span(
                class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border uppercase tracking-wider bg-indigo-50 text-indigo-700 border-indigo-200 shrink-0",
                x-text="selectedQuestionIds.length + ' Qs Selected'"
              )

            // Dynamic Total Marks Meter
            div(class="mt-4")
              div(class="flex justify-between items-baseline mb-1.5")
                span(class="text-xs font-semibold text-slate-600") Total Paper Marks
                div(class="text-sm font-extrabold flex items-baseline gap-1")
                  span(class="text-indigo-600 text-base font-black", x-text="getTotalSelectedMarks()")
                  span(class="text-slate-400 font-normal text-xs", x-text="'/ ' + (customMeta.maxMarks || currentBlueprint.maxMarks || 50) + ' M'")
              div(class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden")
                div(
                  class="h-2.5 rounded-full transition-all duration-300 bg-indigo-600",
                  :style="'width: ' + Math.min(100, (getTotalSelectedMarks() / (customMeta.maxMarks || currentBlueprint.maxMarks || 50)) * 100) + '%'"
                )

            // Section Navigator Checklist (Spacious, Un-squished & Interactive)
            div(class="mt-4 space-y-2")
              div(class="flex items-center justify-between")
                h4(class="text-[11px] font-bold uppercase tracking-wider text-slate-400") Section Navigator
                span(class="text-[10px] text-slate-400") Click to view
              
              template(x-for="(sec, idx) in currentBlueprint.sections", :key="sec.key")
                div(
                  @click="activeSectionKey = sec.key",
                  :class="activeSectionKey === sec.key ? 'bg-indigo-50/80 border-indigo-300 ring-1 ring-indigo-200' : 'hover:bg-slate-50 border-slate-100'",
                  class="p-2.5 rounded-xl border flex items-center justify-between cursor-pointer transition gap-2.5"
                )
                  div(class="flex items-center gap-2.5 min-w-0 flex-1")
                    // Number Pill
                    span(
                      :class="getSectionSelectedCount(sec.key) > 0 ? 'bg-indigo-600 text-white' : 'bg-slate-200 text-slate-500'",
                      class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0",
                      x-text="idx + 1"
                    )
                    
                    div(class="min-w-0 flex-1")
                      div(class="text-xs font-bold text-slate-800 truncate", x-text="getSectionShortTitle(sec)")
                      div(class="text-[10px] text-slate-500 flex items-center gap-1 mt-0.5")
                        span(class="font-semibold text-slate-700", x-text="getSectionSelectedCount(sec.key) + ' Qs'")
                        span &bull;
                        span(class="text-slate-500 font-medium", x-text="getSectionTotalMarks(sec.key) + ' Marks'")
                  
                  div(class="shrink-0 text-right")
                    span(
                      :class="getSectionSelectedCount(sec.key) > 0 ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-slate-100 text-slate-400 border-slate-200'",
                      class="text-[10px] font-bold px-2 py-0.5 rounded-md border inline-block",
                      x-text="getSectionTotalMarks(sec.key) + ' M'"
                    )

            // Quick Actions in Sidebar
            div(class="mt-6 pt-4 border-t border-slate-100 space-y-2")
              button(
                @click="openPreview()",
                :disabled="selectedQuestionIds.length === 0",
                class="w-full py-2.5 px-4 rounded-xl font-bold text-sm bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
              )
                svg(class="w-4 h-4", fill="none", stroke="currentColor", viewBox="0 0 24 24")
                  path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                  path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
                span Preview Exam Paper

              div(class="grid grid-cols-2 gap-2")
                button(
                  @click="downloadMarkdown()",
                  :disabled="selectedQuestionIds.length === 0",
                  class="py-2 px-3 rounded-xl font-medium text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center justify-center gap-1.5 disabled:opacity-50"
                )
