extends layout

block content
  script.
    window.__INITIAL_SUBJECTS__ = !{JSON.stringify(subjects)};
    window.__INITIAL_SUBJECT__ = !{JSON.stringify(initialSubject || {})};

  div(x-data="paperApp()", x-init="init()", class="min-h-screen flex flex-col")
    // Top Header Navigation Bar
    include components/header

    // Main Workspace Layout
    main(class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6")
      // Class & Subject Selector Hub
      include components/subjectSelector

      // Question Bank & Paper Overview Grid
      div(class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start")
        div(class="lg:col-span-2 space-y-6")
          include components/questionBank
        
        div(class="lg:col-span-1")
          include components/paperOverview

    // Dialogs & Modals
    include modals/previewModal
    include modals/savedPapersModal
    include modals/pairingModal
    include modals/createQuestionModal
    include modals/addSubjectModal

    // Notifications Toast
    include components/toast

  // Client Application Logic
  script(src="/js/app.js")
