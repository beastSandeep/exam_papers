//- Full Paper Live Preview Modal
div(
  x-show="previewModalOpen",
  x-cloak,
  class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6"
)
  div(
    class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[94vh] flex flex-col border border-slate-200 overflow-hidden"
  )
    // Modal Header
    div(class="no-print px-5 py-3.5 bg-slate-900 text-white flex flex-wrap items-center justify-between gap-3 border-b border-slate-800")
      div
        h3(class="text-sm sm:text-base font-bold text-white flex items-center gap-2")
          span 📄 Final Exam Paper Preview
          span(class="text-xs px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30", x-text="getTotalSelectedMarks() + ' Marks'")
        p(class="text-[11px] text-slate-400 mt-0.5", x-text="currentBlueprint.name + ' • Ready for print & export'")
      
      div(class="flex items-center flex-wrap gap-2")
        // Layout Mode Switcher (Paper Saver Feature)
        div(class="flex items-center bg-slate-800 p-0.5 rounded-lg border border-slate-700")
          button(
            type="button",
            @click="setPrintLayoutMode('standard')",
            :class="printLayoutMode === 'standard' ? 'bg-indigo-600 text-white shadow-xs font-semibold' : 'text-slate-400 hover:text-white'",
            title="Standard single column layout",
            class="px-2 py-1 text-[11px] rounded transition flex items-center gap-1"
          )
            span 📄 Standard
          button(
            type="button",
            @click="setPrintLayoutMode('compact')",
            :class="printLayoutMode === 'compact' ? 'bg-emerald-600 text-white shadow-xs font-semibold' : 'text-slate-400 hover:text-white'",
            title="Tight margins & spacing - Saves 30-40% paper",
            class="px-2 py-1 text-[11px] rounded transition flex items-center gap-1"
          )
            span 🌿 Paper Saver
          button(
            type="button",
            @click="setPrintLayoutMode('twocolumn')",
            :class="printLayoutMode === 'twocolumn' ? 'bg-amber-600 text-white shadow-xs font-semibold' : 'text-slate-400 hover:text-white'",
            title="2-Column multi-column print - Saves 50-60% paper",
            class="px-2 py-1 text-[11px] rounded transition flex items-center gap-1"
          )
            span 📰 2-Column

        // Instructions Toggle inside Preview Modal
        label(class="flex items-center gap-1.5 text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg border border-slate-700 cursor-pointer select-none transition")
          input(type="checkbox", x-model="customMeta.includeInstructions", @change="persistState(); openPreview()", class="w-3.5 h-3.5 rounded text-indigo-500 focus:ring-0 cursor-pointer")
          span(class="hidden md:inline text-[11px]") Instructions:
          span(:class="customMeta.includeInstructions ? 'text-emerald-400 font-bold text-[11px]' : 'text-slate-400 text-[11px]'", x-text="customMeta.includeInstructions ? 'ON' : 'OFF'")

        button(@click="copyMarkdown()", title="Copy Markdown to Clipboard", class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition flex items-center gap-1 border border-slate-700")
          svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3")
          span(class="hidden sm:inline") Copy .MD

        button(@click="downloadMarkdown()", title="Download .md file", class="px-2.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow transition flex items-center gap-1")
          svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
          span(class="hidden sm:inline") .MD

        button(@click="printDirect()", title="Print or Save as PDF", class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow transition flex items-center gap-1.5")
          svg(class="w-3.5 h-3.5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
          span Print / PDF

        button(@click="previewModalOpen = false", class="text-slate-400 hover:text-white p-1 rounded-lg ml-1")
          svg(class="w-5 h-5", fill="none", stroke="currentColor", viewBox="0 0 24 24")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M6 18L18 6M6 6l12 12")

    // Modal Content: Formatted Exam Sheet
    div(class="flex-1 overflow-y-auto p-4 sm:p-8 bg-slate-100")
      div(
        id="modal-paper-content",
        :class="{ 'paper-saver': printLayoutMode === 'compact', 'two-column-print': printLayoutMode === 'twocolumn' }",
        class="exam-sheet max-w-3xl mx-auto bg-white p-6 sm:p-10 rounded-xl shadow-md border border-slate-200 transition-all"
      )
        // Rendered preview markdown goes here via Alpine openPreview()
